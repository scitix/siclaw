#!/usr/bin/python3 -I
"""Install root-owned, non-writable by the dedicated SSH account. No subprocesses.

authorized_keys: restrict,command="/usr/local/libexec/siclaw-inspect" ssh-ed25519 ...
Only fixed, non-secret paths are exposed. Adding a check requires operator review.
"""
import json
import os
import stat
import sys

CHECKS = {
    "os": {"os_release": "/etc/os-release"},
    "memory": {"meminfo": "/proc/meminfo"},
    "sysctl": {"swappiness": "/proc/sys/vm/swappiness", "overcommit_memory": "/proc/sys/vm/overcommit_memory"},
}


def main():
    request = json.loads(sys.stdin.buffer.readline(1025))
    if not isinstance(request, dict) or set(request) != {"check"} or request["check"] not in CHECKS:
        raise ValueError("Unsupported inspection")
    result = {}
    for name, path in CHECKS[request["check"]].items():
        # /etc/os-release is commonly a root-owned distribution symlink.
        resolved = os.path.realpath(path)
        fd = os.open(resolved, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022:
                raise ValueError("Inspection source is not trusted")
            result[name] = os.read(fd, 16384).decode("utf-8", "replace")
        finally:
            os.close(fd)
    print(json.dumps(result))


if __name__ == "__main__":
    try:
        main()
    except Exception:
        sys.stderr.write("Inspection denied\n")
        sys.exit(1)
